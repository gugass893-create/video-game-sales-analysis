-- Вопрос 1. Какие жанры видеоигр приносят наибольшие мировые продажи?
-- Запрос взят из документа docs/Журнал_расследования_и_первый_запрос.docx (раздел 4).
-- Продажи в миллионах копий. Если игре назначить несколько жанров, её продажи учитываются в каждом из них.
SELECT
    Genres.genre_name AS Жанр,
    ROUND(SUM(Sales.global_sales), 2) AS Мировые_продажи
FROM Genres
JOIN Game_Genres ON Genres.genre_id = Game_Genres.genre_id
JOIN Games ON Game_Genres.game_id = Games.game_id
JOIN Sales ON Games.game_id = Sales.game_id
GROUP BY Genres.genre_name
ORDER BY Мировые_продажи DESC;

-- Вопрос 2. Как менялись мировые продажи видеоигр по годам?
-- В файле excel/02_продажи_по_годам.xlsx текста запроса нет, поэтому запрос составлен по его результатам;
-- проверено: на базе из sql/бд_проект_все_годы.sql он даёт те же значения, что и таблица в Excel.
-- Игры без года (NULL) исключены. Продажи в миллионах копий.
SELECT
    Games.year AS Год_выпуска,
    ROUND(SUM(Sales.global_sales), 2) AS Мировые_продажи
FROM Games
JOIN Sales ON Games.game_id = Sales.game_id
WHERE Games.year IS NOT NULL
GROUP BY Games.year
ORDER BY Games.year;

-- Вопрос 3. Какие игровые платформы имеют наибольшие продажи и в каких регионах они наиболее популярны?
-- Запрос взят из файла excel/03_платформы_по_регионам.xlsx (лист «SQL-запрос»). Продажи в миллионах копий.
SELECT
    Platforms.platform_name AS Платформа,
    ROUND(SUM(Sales.global_sales), 2) AS Мировые_продажи,
    ROUND(SUM(Sales.na_sales), 2) AS Северная_Америка,
    ROUND(SUM(Sales.eu_sales), 2) AS Европа,
    ROUND(SUM(Sales.jp_sales), 2) AS Япония,
    ROUND(SUM(Sales.other_sales), 2) AS Другие_регионы
FROM Platforms
JOIN Sales ON Platforms.platform_id = Sales.platform_id
GROUP BY Platforms.platform_name
ORDER BY Мировые_продажи DESC
LIMIT 10;


PRAGMA foreign_keys = ON;

CREATE TABLE if not exists Genres (
    genre_id INTEGER PRIMARY KEY,
    genre_name TEXT NOT NULL UNIQUE,
    description TEXT
);

CREATE TABLE if not exists Publishers (
    publisher_id INTEGER PRIMARY KEY,
    publisher_name TEXT NOT NULL UNIQUE,
    country TEXT
);

CREATE TABLE if not exists Platforms (
    platform_id INTEGER PRIMARY KEY,
    platform_name TEXT NOT NULL UNIQUE,
    platform_type TEXT
);

CREATE TABLE if not exists Games (
    game_id INTEGER PRIMARY KEY,
    name TEXT NOT NULL,
    year INTEGER,
    publisher_id INTEGER,
    description TEXT,
    FOREIGN KEY (publisher_id) REFERENCES Publishers(publisher_id)
);


CREATE TABLE if not exists Game_Genres (
    game_id INTEGER NOT NULL,
    genre_id INTEGER NOT NULL,
    PRIMARY KEY (game_id, genre_id),
    FOREIGN KEY (game_id) REFERENCES Games(game_id),
    FOREIGN KEY (genre_id) REFERENCES Genres(genre_id)
);

CREATE TABLE if not exists Sales (
    sale_id INTEGER PRIMARY KEY,
    game_id INTEGER NOT NULL,
    platform_id INTEGER NOT NULL,
    na_sales REAL,
    eu_sales REAL,
    jp_sales REAL,
    other_sales REAL,
    global_sales REAL,
    rank INTEGER,
    FOREIGN KEY (game_id) REFERENCES Games(game_id),
    FOREIGN KEY (platform_id) REFERENCES Platforms(platform_id)
);

