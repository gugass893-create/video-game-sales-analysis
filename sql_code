--вопрос 1
SELECT
    Genres.genre_name AS Жанр,
    ROUND(SUM(Sales.global_sales), 2) AS Мировые_продажи
FROM Genres
JOIN Game_Genres
    ON Genres.genre_id = Game_Genres.genre_id
JOIN Games
    ON Game_Genres.game_id = Games.game_id
JOIN Sales
    ON Games.game_id = Sales.game_id
GROUP BY Genres.genre_name
ORDER BY Мировые_продажи DESC;

--вопрос 2
SELECT
    Games.year AS Год,
    ROUND(SUM(Sales.global_sales), 2) AS Мировые_продажи
FROM Games
JOIN Sales
    ON Games.game_id = Sales.game_id
WHERE Games.year IS NOT NULL
GROUP BY Games.year
ORDER BY Games.year ASC;

--вопрос 3
SELECT
    Platforms.platform_name AS Платформа,
    ROUND(SUM(Sales.global_sales), 2) AS Мировые_продажи,
    ROUND(SUM(Sales.na_sales), 2) AS Северная_Америка,
    ROUND(SUM(Sales.eu_sales), 2) AS Европа,
    ROUND(SUM(Sales.jp_sales), 2) AS Япония,
    ROUND(SUM(Sales.other_sales), 2) AS Другие_регионы
FROM Platforms
JOIN Sales
    ON Platforms.platform_id = Sales.platform_id
GROUP BY Platforms.platform_name
ORDER BY Мировые_продажи DESC
LIMIT 10;
